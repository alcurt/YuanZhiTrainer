// Embedded payload resources.
//
// Keep this file ASCII-only: rc.exe decodes the file with the ANSI code page
// unless a BOM or an explicit code page switch is present, and non-ASCII bytes
// in comments can break parsing on some locales.
//
// The DLL is produced by the YZHook project (see the ProjectReference in
// YZTrainer.vcxproj, which guarantees the DLL is linked before this file is
// compiled). YZHOOK_X64 is defined per-platform in the vcxproj.
#include "resource.h"
/* 版本号唯一来源（数值宏 + 等价的窄字符串），与三个命令行工具共用同一个头 */
#include "..\\common\\yz_version.h"

#ifdef YZHOOK_X64
IDR_HOOK_DLL RCDATA "..\\..\\dist\\x64\\YZHook.dll"
#else
IDR_HOOK_DLL RCDATA "..\\..\\dist\\Win32\\YZHook.dll"
#endif

//
// File version resource (visible in the Explorer properties page).
// Strings stay English on purpose: rc.exe decodes this file with the ANSI
// code page, so non-ASCII text here is a locale-dependent risk.
//
#define VS_VERSION_INFO 1

VS_VERSION_INFO VERSIONINFO
 FILEVERSION YZ_VERSION_MAJOR,YZ_VERSION_MINOR,YZ_VERSION_PATCH,YZ_VERSION_BUILD
 PRODUCTVERSION YZ_VERSION_MAJOR,YZ_VERSION_MINOR,YZ_VERSION_PATCH,YZ_VERSION_BUILD
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "alcurt"
            VALUE "FileDescription",  "YZTrainer - Yuanzhi classroom client unlock tool"
            VALUE "FileVersion",      YZ_VERSION_STR_NARROW ".0"
            VALUE "InternalName",     "YZTrainer"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "YZTrainer.exe"
            VALUE "ProductName",      "YZTrainer"
            VALUE "ProductVersion",   YZ_VERSION_STR_NARROW
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
